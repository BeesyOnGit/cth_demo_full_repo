{
    "name": "solid-node-ts-boilerplate",
    "version": "1.0.0",
    "description": "A ready-to-go boilerplate for a SOLID Node.js TypeScript project with security and testing requirements.",
    "main": "dist/server.js",
    "scripts": {
        "start": "node dist/server.js",
        "dev": "nodemon src/server.ts",
        "build": "tsc",
        "postbuild": "node -e \"require('fs').cpSync('src/templates','dist/templates',{recursive:true});require('fs').copyFileSync('package.json','dist/package.json')\"",
        "script": "ts-node src/scripts/script.ts",
        "test": "jest",
        "test:watch": "jest --watch",
        "lint": "eslint . --ext .ts",
        "format": "prettier --write ."
    },
    "keywords": [
        "node",
        "typescript",
        "solid",
        "boilerplate",
        "security",
        "testing"
    ],
    "author": "",
    "license": "ISC",
    "dependencies": {
        "@types/handlebars": "^4.0.40",
        "axios": "^1.13.2",
        "bcrypt": "^6.0.0",
        "cookie-parser": "^1.4.7",
        "cors": "^2.8.5",
        "dotenv": "^16.3.1",
        "express": "^4.18.2",
        "handlebars": "^4.7.8",
        "helmet": "^7.1.0",
        "jsonwebtoken": "^9.0.3",
        "mongoose": "^8.0.3",
        "morgan": "^1.10.0",
        "winston": "^3.11.0",
        "zod": "^3.22.4"
    },
    "devDependencies": {
        "@types/bcrypt": "^6.0.0",
        "@types/cookie-parser": "^1.4.10",
        "@types/cors": "^2.8.17",
        "@types/express": "^4.17.21",
        "@types/jest": "^29.5.11",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/morgan": "^1.9.9",
        "@types/node": "^20.10.4",
        "@types/supertest": "^2.0.16",
        "@typescript-eslint/eslint-plugin": "^6.14.0",
        "@typescript-eslint/parser": "^6.14.0",
        "eslint": "^8.55.0",
        "jest": "^29.7.0",
        "nodemon": "^3.0.2",
        "prettier": "^3.1.1",
        "supertest": "^6.3.3",
        "ts-jest": "^29.1.1",
        "ts-node": "^10.9.2",
        "typescript": "^5.3.3"
    }
}
