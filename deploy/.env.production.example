# Production .env — copy to the deploy folder on the VPS as `.env` (never commit it).
# Passed to the app container (API + front end); PORT is also read by deploy.sh.

# The app runs on the host network: it listens on this port of the VPS
PORT=3010
NODE_ENV=production
PAGINATION_DEFAULT_LIMIT=10
# MongoDB runs inside the app container (data in the mongo_data volume)
MONGODB_URI=mongodb://127.0.0.1:27017/cth
PDF_CONVERSION_API_URL=http://127.0.0.1:3005/api/v1/convert
# Allowed CORS origins, comma separated
FRONTEND_URL=https://cth.inovsoft.online
# Long random string (e.g. `openssl rand -hex 32`)
JWT_SECRET=change_me_long_random_secret
# Access token lifetime in hours
JWT_EXPIRATION=8
JWT_AUTH_REFRESH=5
# Refresh token lifetime in days
JWT_REFRESH_EXPIRATION=7
GROQ_API_KEY=change_me
# Demo mode: show these creds on the login screen (use a low-privilege account)
DEMO_MODE=false
DEMO_EMAIL=
DEMO_PASSWORD=
